<idea-plugin>
    <id>arouter-roadsign</id>
    <name>ARouter Helper</name>
    <version>1.1.0</version>
    <vendor email="zhilong.lzl@alibaba-inc.com" url="https://www.alibaba.com">Alibaba</vendor>

    <depends>com.intellij.java</depends>
    <depends>org.jetbrains.kotlin</depends>

    <description><![CDATA[
    Navigate from ARouter build calls in Java and Kotlin to @Route destinations.
    ]]></description>

    <extensions defaultExtensionNs="com.intellij">
        <codeInsight.lineMarkerProvider language="UAST"
                                        implementationClass="com.alibaba.android.arouter.idea.extensions.NavigationLineMarker"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>
</idea-plugin>
